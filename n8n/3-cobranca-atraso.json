{
  "name": "Gestão de Crédito — 3. Cobrança de atraso (diário)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "schedule-cobranca",
      "name": "Todo dia 10:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.APP_URL }}/api/jobs/filas",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [{ "name": "tipo", "value": "cobranca" }]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-jobs-secret",
              "value": "={{ $env.JOBS_SECRET }}"
            }
          ]
        },
        "options": {}
      },
      "id": "http-fila",
      "name": "GET fila de cobranças",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "itens",
        "options": {}
      },
      "id": "split-itens",
      "name": "Split (um por atraso)",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "msg",
              "name": "mensagem",
              "value": "=Olá {{ $json.nome }}, identificamos {{ $json.dias_atraso }} dia(s) de atraso no seu pagamento. Para regularizar: rolar (só os juros) R$ {{ $json.juros_devido }} ou quitar R$ {{ $json.valor_quitacao }}. Podemos combinar?",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "monta-msg",
      "name": "Monta mensagem",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [860, 300]
    },
    {
      "parameters": {},
      "id": "envia-whatsapp",
      "name": "⚠️ SUBSTITUIR: enviar WhatsApp/e-mail",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1080, 300],
      "notes": "Troque este nó pelo do seu provedor. Destino: {{ $json.telefone }} — Texto: {{ $json.mensagem }}"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.APP_URL }}/api/jobs/notificar",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-jobs-secret",
              "value": "={{ $env.JOBS_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"ciclo_id\": \"{{ $json.ciclo_id }}\",\n  \"tenant_id\": \"{{ $json.tenant_id }}\",\n  \"canal\": \"whatsapp\",\n  \"tipo\": \"cobranca\",\n  \"status\": \"enviado\"\n}",
        "options": {}
      },
      "id": "http-notificar",
      "name": "POST /api/jobs/notificar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    }
  ],
  "connections": {
    "Todo dia 10:00": {
      "main": [[{ "node": "GET fila de cobranças", "type": "main", "index": 0 }]]
    },
    "GET fila de cobranças": {
      "main": [[{ "node": "Split (um por atraso)", "type": "main", "index": 0 }]]
    },
    "Split (um por atraso)": {
      "main": [[{ "node": "Monta mensagem", "type": "main", "index": 0 }]]
    },
    "Monta mensagem": {
      "main": [[{ "node": "⚠️ SUBSTITUIR: enviar WhatsApp/e-mail", "type": "main", "index": 0 }]]
    },
    "⚠️ SUBSTITUIR: enviar WhatsApp/e-mail": {
      "main": [[{ "node": "POST /api/jobs/notificar", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
