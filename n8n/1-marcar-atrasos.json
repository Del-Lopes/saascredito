      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    }
  ],
  "connections": {
    "Todo dia 06:00": {
      "main": [
        [
          {
            "node": "POST /api/jobs/marcar-atrasos",
            "type": "main",
            "index": 0
          }
        ]
